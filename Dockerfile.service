# syntax=docker/dockerfile:1

# Use one documented Python version locally and in the container.
FROM python:3.11-slim

# Prevent Python from writing .pyc files and force immediate log flushing.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# build-essential is required to compile the pybind11 C++ extension.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency metadata first so Docker can cache this layer.
COPY service/requirements.txt ./service/requirements.txt

# Install the pinned runtime dependencies.
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir -r service/requirements.txt

# Copy and compile the C++ extension.
# There is intentionally no "|| true": a broken native build must fail visibly.
COPY service/kernels ./service/kernels
RUN python -m pip install --no-cache-dir ./service/kernels

# Copy the service only after dependencies are installed.
COPY service ./service

# The Kubernetes service and local Docker command use port 8080.
EXPOSE 8080

# Use exec form so the process receives termination signals correctly.
CMD ["python", "-m", "uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8080"]
